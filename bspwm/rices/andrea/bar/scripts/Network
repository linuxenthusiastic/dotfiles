is_online() {
	ping -c 1 -W 1 archlinux.org >/dev/null 2>&1
}

# Solo la interfaz de la ruta por defecto. Antes se listaban todas las que
# estaban UP (docker, bridges, veth...) y la etiqueta de la barra crecia una
# linea por interfaz: la barra llegaba a medir ~310px de alto.
ID=$(ip route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }}')

ICON="images/no-wifi.png"
STATUS="Offline"

if is_online; then
	ICON="images/wifi.png"

    case "$ID" in
		e*) STATUS="$ID" ;;  # ethernet
		*)
			if command -v nmcli >/dev/null 2>&1; then
				STATUS=$(nmcli -t -f active,ssid dev wifi | awk -F: '$1 == "yes" { print $2; exit }')
			fi
			;;
	esac
fi

case "$1" in
    --stat) echo "$STATUS" ;;
    --icon) echo "$ICON" ;;
esac
