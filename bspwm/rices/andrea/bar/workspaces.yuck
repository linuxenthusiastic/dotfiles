;; Workspaces ;;
(deflisten workspace0 "scripts/WorkSpaces DP-2")
;; Workspaces Widgets ;;
(defwidget workspace0 [] (literal :content workspace0))
;; Workspaces Main Widget ;;
(defwidget workspaces [monitor]
 (box :halign "center"
 :spacing 10
 :space-evenly "false"
 (box :visible { monitor=="DP-2" } (workspace0))
))